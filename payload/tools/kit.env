# Architect<->Worker kit config (v2). KEY=VALUE, one per line. Edited by the ARCHITECT only.
# tools/kit.env is in the implicit frozen core (E3): a worker edit shows as FROZEN-CHANGED until the architect re-baselines.
PROJECT_NAME={{PROJECT_NAME}}
# Python used by the kit itself (Windows/Git Bash: the project's venv python by full path, not the system one)
PY=python3
# ONE command that runs the whole test suite; run from TEST_DIR (relative to repo root).
# `aw.py gate` and every .aw/checks.d run with PYTHONPATH REMOVED (a host PYTHONPATH made a green gate print count=0 exit=4).
# If a suite needs an extra path, put it INSIDE this command (e.g. PYTHONPATH=src python3 -m pytest -q) - it is still clean.
TEST_DIR=.
TEST_CMD=python3 -m pytest -q
# Presets (copy ONE over TEST_CMD/COUNT_REGEX):
#   pytest   : python3 -m pytest -q                      COUNT_REGEX=(\d+) passed
#   unittest : python3 -I -B -m unittest discover -v     COUNT_REGEX=Ran (\d+) tests?
#   node     : node --test                               COUNT_REGEX=(?m)^\S* ?pass (\d+)\s*$   (tap prints "# pass N", spec prints "<mark> pass N")
#   cargo    : cargo test --lib                          COUNT_REGEX=(\d+) passed               (the LAST "N passed" line wins: doc-tests or a 2nd binary would hide the rest)
# group 1 of the LAST match = number of passing tests (the regex needs exactly one group)
COUNT_REGEX=(\d+) passed
# any match = the suite is red, whatever the exit code says
FAIL_REGEX=(?m)(^|[^0-9])[1-9][0-9]* (failed|errors?)\b|^FAILED |^ERROR |Traceback \(most recent call last\)$
TIMEOUT_S=900
# Reasoning effort (hermes --reasoning: none minimal low medium high xhigh max ultra). tools/effort.py reads these three; START_ARCHITECT.cmd and START_WORKER.cmd pass its answer to `hermes`.
# On the wire ultra is sent as max for claude-sonnet-5-5 and deepseek-v4.1-flash. A running chat cannot change its own level: see PLAYBOOK section 12.
EFFORT_DEFAULT=medium
EFFORT_HARD=ultra
# Worker: ONE level for every card. 12 pilots (2026-11-08): ultra 6 of 6 queues passed, medium 5 of 6 (p=1.0, a hint, not proof); wall time overlaps; ultra ~2x the reasoning tokens, on a route that does not draw on the Architect's subscription. auto = rules W2-W4 of effort.py: medium unless the card is hard.
EFFORT_WORKER=ultra
# files the worker may always write (besides the task's OWNS): comma list of globs
ALWAYS_OWNED=.hermes/plans/WORKLOG.md,.hermes/plans/gate_output/**,.hermes/plans/backups/**,.hermes/plans/REPORT_latest.md,.hermes/plans/QUESTIONS.md,.aw/task-start
# WORKLOG older than newest gate_output by more than this many seconds => WARN
WORKLOG_STALE_S=1800
